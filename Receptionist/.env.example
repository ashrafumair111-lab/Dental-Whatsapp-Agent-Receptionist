# Copy to .env.local for local dev, and keep .env.production as the deployed copy.
# Never commit real keys.

# --- LiveKit Cloud (project: jarvis) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cal.com ---
CAL_API_KEY=
CAL_USERNAME=
# Optional: default phone region for parsing numbers without a country code
DEFAULT_PHONE_REGION=PK

# --- Company / prompt ---
COMPANY_NAME=Dental Clinic
# Semicolon-separated list, e.g. "AI strategy;Model evaluation;Deployment"
COMPANY_SERVICES=

# --- Models ---
# LLM runs on Groq (OpenAI-compatible, free tier: 1,000 req/day). The fallback
# model has its own rate-limit bucket, so a burst never leaves the caller silent.
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Optional override, defaults to https://api.groq.com/openai/v1
GROQ_BASE_URL=

# STT runs on Deepgram with your own key (nova-3 supports Urdu).
# `multi` starts the call (perfect English); the agent switches to `ur` as soon
# as it hears Urdu, because `ur` cannot transcribe English at all.
DEEPGRAM_API_KEY=
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
# Comma-separated extra names/terms to bias transcription
STT_KEYTERMS=

# TTS: Deepgram Aura for English; Azure Speech neural voice for Urdu
# (ur-PK-AsadNeural) — cleaner than Edge's 48kbps MP3. Edge stays as the
# automatic fallback if Azure fails. Free F0 tier: 0.5M chars/month.
DEEPGRAM_API_KEY=
TTS_EN_MODEL=aura-2-odysseus-en
TTS_UR_VOICE=ur-PK-AsadNeural
# Urdu legs run faster: 1.25 reads naturally on phone calls; English keeps TTS_SPEED.
TTS_UR_SPEED=1.25
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Legacy LiveKit-Inference TTS, only used when DEEPGRAM_API_KEY is empty.
TTS_MODEL=inworld/inworld-tts-2

# --- Latency tuning (defaults validated on live phone calls) ---
# Speaking rate: 1.0 = normal, professional pace (Cartesia "speed" / Inworld
# "speaking_rate"). 1.15 sounds rushed on a receptionist line.
TTS_SPEED=1.0
# Dynamic endpointing upper bound in seconds. Lower = snappier, but 0.6 or below
# can cut callers off mid-sentence.
ENDPOINTING_MAX_DELAY=0.7
# Cap on reply length; shorter replies start speaking sooner.
LLM_MAX_TOKENS=300
# End-of-turn strategy: "vad" (default here — no inference credit) or "model"
# (semantic TurnDetector, requires LiveKit Inference).
TURN_DETECTION=vad
# Per-language voices (only used by the legacy inference path; the Deepgram
# build routes to TTS_EN_MODEL / TTS_UR_VOICE instead).
TTS_VOICE_EN=Alex
TTS_VOICE_UR=Alex
# "auto" = follow the caller (greeting is Urdu), "en"/"urdu" = pin one language.
LANG_MODE=auto

# --- Noise cancellation (ai_coustics) ---
AI_COUSTICS_API_KEY=

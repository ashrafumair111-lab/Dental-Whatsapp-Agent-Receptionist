# Copy to .env.local for local dev, and keep .env.production as the deployed copy.
# Never commit real keys.

# --- LiveKit Cloud (project: jarvis) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cal.com ---
CAL_API_KEY=
CAL_USERNAME=
# Optional: default phone region for parsing numbers without a country code
DEFAULT_PHONE_REGION=PK

# --- Company / prompt ---
COMPANY_NAME=Dental Clinic
# Semicolon-separated list, e.g. "AI strategy;Model evaluation;Deployment"
COMPANY_SERVICES=

# --- Models (all served through LiveKit Inference) ---
# Cheap defaults: Gemini Flash Lite LLM, AssemblyAI streaming STT, Inworld Flash TTS.
# Avoid reasoning models here (e.g. gpt-5-nano): they spend the reply token
# budget on hidden reasoning and the agent goes silent after the greeting.
LLM_MODEL=google/gemini-3.1-flash-lite
STT_MODEL=assemblyai/universal-streaming
TTS_MODEL=inworld/inworld-tts-2-flash
# Comma-separated extra names/terms to bias transcription (Deepgram only)
STT_KEYTERMS=

# --- Latency tuning (defaults validated on live phone calls) ---
# Speaking rate: 1.0 = normal, professional pace (Cartesia "speed" / Inworld
# "speaking_rate"). 1.15 sounds rushed on a receptionist line.
TTS_SPEED=1.0
# Dynamic endpointing upper bound in seconds. Lower = snappier, but 0.6 or below
# can cut callers off mid-sentence.
ENDPOINTING_MAX_DELAY=0.7
# Cap on reply length; shorter replies start speaking sooner.
LLM_MAX_TOKENS=120
# End-of-turn strategy: "model" (default, semantic TurnDetector) or "vad"
# (audio only, falls back to endpointing when STT finals stall).
TURN_DETECTION=model
# Per-language voices. English default depends on TTS_MODEL: Blake (Cartesia)
# or Alex (Inworld). For Urdu mode, set TTS_VOICE_UR to a native Urdu voice ID
# and LANG_MODE=urdu.
TTS_VOICE_EN=Alex
LANG_MODE=en

# --- Noise cancellation (ai_coustics) ---
AI_COUSTICS_API_KEY=
